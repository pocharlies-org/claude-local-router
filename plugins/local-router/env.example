# claude-local-router — gateway credentials.
#
# Copy to ~/.config/claude-local/env and fill in. This file is READ BY THE ROUTER ONLY;
# it is never sent to Anthropic. Reload after editing, without restarting:
#   kill -HUP $(pgrep -f claude-router.js)
#
# Keep this file out of git. Use a key scoped to this gateway, not an admin/master key,
# so it can be rotated on its own.

# Where your local models live. Must speak the Anthropic /v1/messages API
# (LiteLLM does this natively).
export ANTHROPIC_BASE_URL="https://your-gateway.example.com"

# A virtual/scoped key for that gateway.
export ANTHROPIC_AUTH_TOKEN="sk-CHANGEME"

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. The router does not read these — Claude Code does,
# if you choose to source this file into the CLI's environment instead of relying on
# the model picker. Most setups do not need them.
# ---------------------------------------------------------------------------

# Default model for the session.
#export ANTHROPIC_MODEL="qwen38-flash-next"

# Small model for background tasks (titles, summaries). Make sure your gateway key is
# actually allowed to call it — a key-scoped denial here shows up as a confusing 403
# on an unrelated background request.
#export ANTHROPIC_SMALL_FAST_MODEL="qwen38-flash-next"

# Remap the opus/sonnet/haiku aliases onto local models. Only needed if settings.json
# pins "model" to one of those aliases AND you want it served locally.
#export ANTHROPIC_DEFAULT_OPUS_MODEL="qwen38-flash-next"
#export ANTHROPIC_DEFAULT_SONNET_MODEL="qwen38-flash-next"
#export ANTHROPIC_DEFAULT_HAIKU_MODEL="qwen38-flash-next"

# Your model's REAL context window. Without this Claude Code assumes 200k for a model it
# does not know and auto-compacts early, losing context you still had room for. Check the
# engine (/v1/models -> max_model_len) rather than guessing.
#export CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144
